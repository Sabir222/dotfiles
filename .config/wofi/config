# Window dimensions and positioning
# 444x372 = 420x360 content + 24x12 insets from style.css. Done this way so
# wofi never resizes its layer surface after the first frame (no "vibration").
width=444
height=372
location=center
orientation=vertical
halign=fill
line_wrap=off

# Appearance settings
show=drun
prompt=Search...
filter_rate=100
allow_markup=true
no_actions=true
allow_images=true
image_size=24

# Performance and behavior
insensitive=true
parse_search=true
gtk_dark=true
matching=contains


# Cache settings
cache_file=/home/sabir/.cache/wofi-drun
term=alacritty

# Key bindings (optional)
key_expand=Tab
key_exit=Escape
